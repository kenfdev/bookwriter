#!/bin/zsh
set -euo pipefail

function help_wanted {
  for arg in "$@"; do
    if [[ $arg == -- ]]; then
      return 1
    fi
    if [[ $arg == --help || $arg == -h ]]; then
      return 0
    fi
  done
  return 1
}

source=${0:A}
ROOT=${source:h}
usage=$ROOT/usage.txt

if help_wanted "$@"; then
  cat "$usage"
  exit 0
fi

if [[ $# -ne 1 ]]; then
  cat "$usage" >&2
  exit 64
fi
if [[ ! -d $1 ]]; then
  print -u2 "bw: not a directory: $1"
  exit 1
fi

BOOK=$(cd -- $1 && pwd)
cd $ROOT
npm run build
export CARGO_TARGET_DIR=$ROOT/src-tauri/target-bw
cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol
exec $CARGO_TARGET_DIR/debug/bookwriter $BOOK
